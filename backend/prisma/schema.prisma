generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  SUSPENDED
  RESIGNED
  TERMINATED
}

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model users {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  role          String
  employee_id   String?  @unique
  last_login_at DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model employees {
  id                String           @id @default(uuid())
  company_id        String
  employee_code     String           @unique
  first_name        String
  last_name         String
  position          String
  department        String
  employment_status EmploymentStatus @default(ACTIVE)
  salary_base       Decimal          @db.Decimal(12, 2)
  created_at        DateTime         @default(now())
  updated_at        DateTime         @updatedAt
}

model companies {
  id                  String   @id @default(uuid())
  name                String
  logo_url            String?
  timezone            String   @default("Asia/Bangkok")
  payroll_cycle       String   @default("MONTHLY")
  gps_enforcement     Boolean  @default(true)
  working_rule_json   Json
  payroll_config_json Json
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}

model locations {
  id           String   @id @default(uuid())
  company_id   String
  name         String
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  radius_meter Int
  allow_remote Boolean  @default(false)
  created_at   DateTime @default(now())
}

model shifts {
  id             String   @id @default(uuid())
  company_id     String
  shift_code     String
  name           String
  start_time     String
  end_time       String
  benefit_amount Decimal  @db.Decimal(10, 2)
  individual_for String?
  created_at     DateTime @default(now())
}

model holidays {
  id            String   @id @default(uuid())
  company_id    String
  holiday_group String
  holiday_date  DateTime
  name          String
  auto_apply    Boolean  @default(true)
}

model attendance {
  id                String         @id @default(uuid())
  employee_id       String
  attendance_type   AttendanceType
  at_time           DateTime
  latitude          Decimal        @db.Decimal(10, 7)
  longitude         Decimal        @db.Decimal(10, 7)
  is_gps_valid      Boolean
  late_minutes      Int            @default(0)
  source_ip         String?
}

model leave_requests {
  id             String      @id @default(uuid())
  employee_id    String
  leave_type     String
  start_date     DateTime
  end_date       DateTime
  days           Decimal     @db.Decimal(5, 2)
  status         LeaveStatus @default(PENDING)
  approver_chain Json
  created_at     DateTime    @default(now())
}

model approvals {
  id              String   @id @default(uuid())
  reference_type  String
  reference_id    String
  level           Int
  approver_id     String
  approver_group  String?
  dynamic_rule    String?
  status          String
  action_at       DateTime?
}

model payroll {
  id                  String   @id @default(uuid())
  company_id          String
  period              String
  gross_salary        Decimal  @db.Decimal(12, 2)
  tax                 Decimal  @db.Decimal(12, 2)
  social_security     Decimal  @db.Decimal(12, 2)
  overtime            Decimal  @db.Decimal(12, 2)
  deductions          Decimal  @db.Decimal(12, 2)
  net_salary          Decimal  @db.Decimal(12, 2)
  generated_at        DateTime @default(now())
  export_pdf_url      String?
  export_excel_url    String?
  export_government_url String?
}

model payslips {
  id            String   @id @default(uuid())
  payroll_id    String
  employee_id   String
  payslip_no    String   @unique
  net_salary    Decimal  @db.Decimal(12, 2)
  issue_date    DateTime @default(now())
}

model projects {
  id            String   @id @default(uuid())
  company_id    String
  name          String
  description   String?
  employee_ids  Json
  tracked_hours Decimal  @db.Decimal(8, 2)
}

model news {
  id              String   @id @default(uuid())
  company_id      String
  title           String
  content         String
  target_employee Json
  read_status     Json
  published_at    DateTime @default(now())
}

model certificates {
  id                String   @id @default(uuid())
  company_id        String
  template_name     String
  template_url      String
  language_support  String   @default("TH_EN")
  generated_payload Json
  created_at        DateTime @default(now())
}

model credits {
  id             String   @id @default(uuid())
  company_id     String
  usage_count    Int      @default(0)
  quota_limit    Int
  billing_amount Decimal  @db.Decimal(12, 2)
  updated_at     DateTime @updatedAt
}

model logs {
  id          String   @id @default(uuid())
  user_id     String?
  action      String
  detail_json Json
  ip_address  String?
  created_at  DateTime @default(now())
}
